# ============================================================================
# GRAM PANCHAYAT ELECTORAL ROLL SEARCH - ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this file to a new file named `.env` in the root folder.
# NEVER commit your actual `.env` file or real credentials to Git!
# ============================================================================

# Server Port (default: 3001)
PORT=3001

# ----------------------------------------------------------------------------
# DATA SOURCE MODE
# ----------------------------------------------------------------------------
# Allowed values:
#   SAMPLE              -> Uses fictitious sample records from backend/data/sampleVoters.js
#                          (Safe for initial local testing before connecting Google Sheets)
#   GOOGLE_SHEETS_API   -> Recommended Private Method: Connects to your private Google Sheet
#                          on the backend using a Google Cloud Service Account.
#   PUBLIC_CSV          -> Optional Alternative: Fetches from a publicly published CSV URL.
#                          WARNING: Makes your entire spreadsheet publicly downloadable by anyone.
GOOGLE_SHEETS_MODE=SAMPLE

# ----------------------------------------------------------------------------
# GOOGLE SHEETS IDENTIFIERS (Required when GOOGLE_SHEETS_MODE=GOOGLE_SHEETS_API)
# ----------------------------------------------------------------------------
# Your Google Spreadsheet ID (from the spreadsheet URL between /d/ and /edit)
GOOGLE_SHEET_ID=YOUR_GOOGLE_SHEET_ID_HERE

# The exact name of the sheet tab at the bottom of your Google Sheet (e.g., Sheet1 or ElectoralRoll)
GOOGLE_SHEET_TAB_NAME=Sheet1

# ----------------------------------------------------------------------------
# GOOGLE SERVICE ACCOUNT CREDENTIALS (Required for GOOGLE_SHEETS_API mode)
# ----------------------------------------------------------------------------
# Option A: Provide the Service Account Email and Private Key directly
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project-id.iam.gserviceaccount.com
# Note: Keep the quotes around the private key and preserve \n newline characters
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Option B: Or provide the path to your downloaded service-account JSON file
# (Make sure this file is listed in .gitignore and never committed!)
GOOGLE_APPLICATION_CREDENTIALS_PATH=

# ----------------------------------------------------------------------------
# OPTIONAL PUBLIC CSV URL (Only if GOOGLE_SHEETS_MODE=PUBLIC_CSV)
# ----------------------------------------------------------------------------
# Privacy Warning: Publishing a sheet to the web allows anyone with the link
# to access the entire underlying dataset. Prefer GOOGLE_SHEETS_API mode instead.
GOOGLE_SHEET_PUBLIC_CSV_URL=

# ----------------------------------------------------------------------------
# PRIVACY & PERFORMANCE SETTINGS
# ----------------------------------------------------------------------------
# Set to "true" ONLY if you are legally authorized and wish to send Voter ID / EPIC
# numbers to the browser and display them on result cards.
# If "false" (recommended default), the backend strips Voter IDs before sending data
# to the browser so they cannot be inspected in browser network developer tools.
ALLOW_VOTER_ID_DISPLAY=false

# Cache duration in seconds so the server does not re-download the entire Google Sheet
# on every search request (default: 300 seconds = 5 minutes).
CACHE_TTL_SECONDS=300
